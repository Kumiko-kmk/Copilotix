{
  "name": "mineru-desktop",
  "version": "0.1.0",
  "description": "Unofficial MinerU desktop reader with Markdown translation",
  "main": "./out/main/index.js",
  "author": "Kumiko-kmk",
  "license": "AGPL-3.0-only",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build": "node scripts/clean-output.mjs && pnpm typecheck && electron-vite build",
    "package:directory": "pnpm build && node scripts/package-directory.mjs"
  },
  "dependencies": {
    "@napi-rs/keyring": "^1.3.0",
    "archiver": "^7.0.1",
    "extract-zip": "^2.0.1",
    "parse5": "^7.3.0"
  },
  "devDependencies": {
    "@ant-design/icons": "^6.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/archiver": "^6.0.3",
    "@types/node": "^24.5.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "antd": "^5.27.0",
    "electron": "^37.4.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "jsdom": "^27.0.0",
    "katex": "^0.18.4",
    "p-queue": "^8.1.0",
    "pdfjs-dist": "^5.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5",
    "uuid": "^11.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  },
  "build": {
    "appId": "com.kumiko.mineru.translation",
    "productName": "MinerU",
    "executableName": "MinerU",
    "asar": true,
    "electronLanguages": ["zh-CN"],
    "asarUnpack": [
      "node_modules/@napi-rs/keyring/**"
    ],
    "extraResources": [
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      }
    ],
    "directories": { "output": "../release/.staging", "buildResources": "resources" },
    "files": ["out/**/*", "package.json"],
    "win": {
      "target": ["dir"],
      "icon": "resources/icon.png"
    }
  }
}
