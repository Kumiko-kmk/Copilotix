{
  "name": "copilotix-desktop",
  "version": "0.1.0",
  "description": "Copilotix desktop PDF reader with Markdown translation",
  "main": "./out/main/index.js",
  "author": "Kumiko-kmk",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "pnpm build:utility && electron-vite dev",
    "build:utility": "vite build --config utility.vite.config.ts && node scripts/utility-bundle-smoke.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint \"src/**/*.ts\" \"src/**/*.tsx\" \"tests/**/*.ts\" \"tests/**/*.tsx\" electron.vite.config.ts utility.vite.config.ts vitest.config.ts playwright.config.ts",
    "build:bundles": "node scripts/clean-output.mjs && electron-vite build && pnpm build:utility",
    "build": "pnpm typecheck && pnpm build:bundles",
    "package:directory": "pnpm build && node scripts/package-directory.mjs",
    "package:directory:from-built": "node scripts/package-directory.mjs --from-built",
    "verify:release-tag": "node scripts/verify-release-tag.mjs",
    "verify:release-license": "node scripts/verify-release-license.mjs",
    "verify:release-signing": "node scripts/verify-release-signing.mjs",
    "verify:release-assets": "node scripts/verify-release-assets.mjs"
  },
  "dependencies": {
    "@napi-rs/keyring": "^1.3.0",
    "@tanstack/react-query": "^5.102.8",
    "archiver": "^7.0.1",
    "extract-zip": "^2.0.1",
    "parse5": "^7.3.0",
    "pdfjs-dist": "^5.4.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@ant-design/icons": "^6.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron/asar": "3.4.1",
    "@electron/fuses": "1.8.0",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/archiver": "^6.0.3",
    "@types/node": "^24.5.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "3.2.7",
    "antd": "^5.27.0",
    "electron": "44.1.1",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "jsdom": "^27.0.0",
    "katex": "^0.18.4",
    "p-queue": "^8.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "unified": "^11.0.5",
    "uuid": "^11.1.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  },
  "build": {
    "appId": "com.kumiko.copilotix.translation",
    "productName": "Copilotix",
    "executableName": "Copilotix",
    "asar": true,
    "electronLanguages": [
      "zh-CN"
    ],
    "asarUnpack": [
      "out/utility/**",
      "node_modules/@napi-rs/keyring/**",
      "node_modules/@napi-rs/keyring-win32-x64-msvc/**",
      "node_modules/pdfjs-dist/**"
    ],
    "extraResources": [
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      },
      {
        "from": "../LICENSE.md",
        "to": "licenses/Copilotix-MIT.txt"
      },
      {
        "from": "../THIRD_PARTY_NOTICES.md",
        "to": "licenses/THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "out/licenses/THIRD_PARTY_LICENSES.txt",
        "to": "licenses/THIRD_PARTY_LICENSES.txt"
      }
    ],
    "directories": {
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!out/licenses/**"
    ],
    "win": {
      "target": [
        "dir"
      ],
      "icon": "resources/icon.png"
    },
    "afterPack": "./scripts/after-pack.mjs"
  }
}
